# MongoDB 연결 URI
MONGODB_URI=mongodb://localhost:27017/cooking-app
# 또는 MongoDB Atlas 사용 시:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cooking-app

# JWT 시크릿 키 (랜덤 문자열로 변경 필요)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Key (향후 사용)
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# API Base URL (향후 백엔드 구축 시 사용)
VITE_API_BASE_URL=http://localhost:3000/api

# Environment
VITE_ENV=development

# 서버 포트
PORT=3000
